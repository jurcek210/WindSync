<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/colorBackground">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Simulacija ekstremnih dogodkov"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvIntervalLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Interval preverjanja"
        android:textColor="@color/colorTextSecondary"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <Spinner
        android:id="@+id/spinnerInterval"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvIntervalLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Switch
        android:id="@+id/switchSimulation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vklopi simulacijo"
        android:textColor="@color/colorTextPrimary"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerInterval"
        app:layout_constraintStart_toStartOf="parent"/>

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"
        android:background="@color/sky_blue_light"
        app:layout_constraintTop_toBottomOf="@id/switchSimulation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnGenerateExtreme"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Generiraj ekstremni dogodek"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:id="@+id/tvSimulationLog"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Zaznani ekstremni dogodki:\n"
        android:textSize="14sp"
        android:textColor="@color/text_primary" />


</androidx.constraintlayout.widget.ConstraintLayout>

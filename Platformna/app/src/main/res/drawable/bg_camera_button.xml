<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/sky_blue_dark"/>
            <size
                android:width="64dp"
                android:height="64dp"/>
            <elevation android:value="2dp"/>
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/sky_blue"/>
            <size
                android:width="64dp"
                android:height="64dp"/>
            <elevation android:value="4dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/sky_blue_dark"/>
            <size
                android:width="64dp"
                android:height="64dp"/>
            <elevation android:value="6dp"/>
        </shape>
    </item>

</selector>
